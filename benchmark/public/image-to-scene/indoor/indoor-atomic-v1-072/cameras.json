        500.0,
        820.0,
        80.0
      ],
      "fov_deg": 80.0,
      "lighting": {
        "fill_intensity": 180.0,
        "top_intensity": 90.0,
        "exposure_bias": -0.35
      },
      "streaming_pool_mb": 4000,
      "publish": {
        "file": "references/view-01.png",
        "format": "png",
        "width": 1280,
        "height": 720
      }
    },
    {
      "name": "view-02",
