{
  "schema_version": "code4scene.cameras.v1",
  "case_id": "indoor-atomic-v1-072",
  "capture_map": "ground_truth",
  "capture": {
    "method": "scene_capture_2d",
    "width": 1920,
    "height": 1080,
    "capture_count": 4,
    "capture_source": "SCS_FINAL_COLOR_LDR",
    "console": [
      "viewmode lit",
      "r.AntiAliasingMethod 2",
      "sg.AntiAliasingQuality 4",
      "r.ScreenPercentage 100",
      "r.Streaming.FullyLoadUsedTextures 1"
    ],
    "fill_light": {
      "at": "camera",
      "attenuation_radius_cm": 3200.0,
      "cast_shadows": false
    },
    "top_light": {
      "at": "target",
      "offset_z_cm": 320.0,
      "attenuation_radius_cm": 2600.0,
      "cast_shadows": false
    },
    "rotation": "look_at(location_cm, target_cm)",
    "fov": "fov_deg is the horizontal field of view of the capture component"
  },
  "views": [
    {
      "name": "view-01",
      "location_cm": [
        100.0,
        600.0,
        180.0
      ],
